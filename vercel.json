{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "servidor.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/extrair",
      "dest": "servidor.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
