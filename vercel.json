{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "servidor.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/extrair",
      "destination": "/servidor.js"
    },
    {
      "src": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
